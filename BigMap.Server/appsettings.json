{
  "TileCache": {
    "RootPath": "cache",
    "StyleVersion": "bigmap-v1",
    "MaxZoom": 14
  },
  "TileRenderer": {
    "BaseUrl": "http://127.0.0.1:8081",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
