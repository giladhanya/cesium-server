{
  "version": 8,
  "sources": {
    "world": {
      "type": "vector",
      "url": "mbtiles://{world}"
    }
  },
  "layers": [
    {
      "id": "poi-points",
      "type": "circle",
      "source": "world",
      "source-layer": "poi",
      "minzoom": 12,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1.5,
          17,
          3.5
        ],
        "circle-color": "#a85d3d",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 0.8,
        "circle-opacity": 0.85
      }
    }
  ]
}
