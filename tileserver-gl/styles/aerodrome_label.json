{
  "version": 8,
  "sources": {
    "world": {
      "type": "vector",
      "url": "mbtiles://{world}"
    }
  },
  "layers": [
    {
      "id": "aerodrome-points",
      "type": "circle",
      "source": "world",
      "source-layer": "aerodrome_label",
      "minzoom": 8,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          14,
          5
        ],
        "circle-color": "#8055a5",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 1.2,
        "circle-opacity": 0.9
      }
    }
  ]
}
