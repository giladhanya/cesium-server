{
  "version": 8,
  "sources": {
    "world": {
      "type": "vector",
      "url": "mbtiles://{world}"
    }
  },
  "layers": [
    {
      "id": "waterway-line",
      "type": "line",
      "source": "world",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#4f95bf",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          14,
          2.2
        ],
        "line-opacity": 0.85
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    }
  ]
}
